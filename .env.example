DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio_cms

# Email do dono do portfólio. Se definido, `npm run db:seed` promove essa
# conta para ADMIN (não cria a conta — ela precisa existir antes, seja
# via login com Google ou via seed local). Também é o destinatário dos
# e-mails do formulário "Pagar um café".
OWNER_EMAIL=

# API key da Resend (resend.com > API Keys), usada para enviar o e-mail do
# formulário "Pagar um café" para OWNER_EMAIL. O remetente (contato@shin.dev.br)
# está fixo em server/services/contact.service.ts e exige o domínio
# shin.dev.br verificado na Resend (DKIM/SPF configurados via DNS).
RESEND_API_KEY=

# Credenciais OAuth do Google (console.cloud.google.com > APIs e serviços
# > Credenciais). Usadas pelo login social dos leitores (comentar/curtir).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
