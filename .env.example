DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio_cms

# Email do dono do portfólio. Se definido, `npm run db:seed` promove essa
# conta para ADMIN (não cria a conta — ela precisa existir antes, seja
# via login com Google ou via seed local).
OWNER_EMAIL=

# Credenciais OAuth do Google (console.cloud.google.com > APIs e serviços
# > Credenciais). Usadas pelo login social dos leitores (comentar/curtir).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
